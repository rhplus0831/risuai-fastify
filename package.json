{
  "name": "risuai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build --sourcemap",
    "report:bundle-boundaries": "tsx util/bundle-boundary-report.ts --dist dist --input dist/bundle-boundary-report.json --json fast-bootstrap-results/bundle-boundaries.json --text fast-bootstrap-results/bundle-boundaries.txt",
    "report:initial-preload": "tsx util/initial-preload-report.ts --dist dist --budget util/initial-preload-budgets.json --json fast-bootstrap-results/initial-preload.json --text fast-bootstrap-results/initial-preload.txt",
    "build:initial-preload": "cross-env VITE_FAST_BOOTSTRAP_REPORT=TRUE pnpm build && pnpm report:bundle-boundaries && pnpm report:initial-preload",
    "measure:fast-bootstrap": "pnpm build:initial-preload && pnpm build:smoke && playwright test -c playwright.fastify-smoke.config.ts server/fastify/browser-smoke/startupCachePopulationMatrix.spec.ts",
    "verify:fast-bootstrap": "pnpm measure:fast-bootstrap && cross-env RISU_FAST_BOOTSTRAP_ARTIFACT_REQUIRED=true playwright test -c playwright.fastify-smoke.config.ts server/fastify/browser-smoke/startupDirectLinks.spec.ts server/fastify/browser-smoke/startupRecoveryIntegrationMatrix.spec.ts",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:protocol": "tsc -p packages/protocol/tsconfig.json --noEmit",
    "check:shared-core": "tsc -p packages/shared-core/tsconfig.json --noEmit",
    "check:shared-core:boundary": "vitest run packages/shared-core/src/importBoundary.test.ts packages/shared-core/src/ownership.test.ts",
    "check:docs": "tsx util/current-documentation-validator.ts",
    "check:server": "tsx util/check-server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check . --experimental-cli --no-cache",
    "test": "tsx util/focused-test.ts",
    "test:compat-harness": "tsx test/compat-harness/run.ts",
    "prepare:compat-baseline": "tsx util/compat-baseline.ts --prepare",
    "validate:compat-registers": "tsx util/validate-original-risu-compatibility-registers.ts",
    "test:agent": "tsx util/test-agent.ts",
    "test:all": "tsx util/test-all.ts",
    "coverage:all": "sh -c 'pnpm coverage:frontend; frontend=$?; pnpm coverage:backend; backend=$?; exit $((frontend || backend))'",
    "coverage:frontend": "cross-env RISU_TEST_INCLUDE_GATES=true vitest run --coverage --coverage.provider=v8 --coverage.reportsDirectory=coverage/frontend --coverage.include='src/**/*.{ts,svelte}' --coverage.include='util/**/*.ts' --coverage.exclude='server/**' --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "coverage:backend": "vitest run --config server/fastify/vitest.config.ts --coverage --coverage.provider=v8 --coverage.reportsDirectory=../../coverage/backend --coverage.include='src/**/*.ts' --coverage.reporter=text --coverage.reporter=json-summary --coverage.reporter=html",
    "coverage:ui-map": "vitest run src/lib/Others/GridCatalog.svelte.test.ts src/lib/Others/ChatList.svelte.test.ts src/lib/SideBars/SideChatList.svelte.test.ts src/lib/SideBars/Sidebar.charList.test.ts src/lib/ChatScreens/ChatBody.svelte.test.ts src/lib/ChatScreens/DefaultChatScreen.loadPages.test.ts --coverage --coverage.provider=v8 --coverage.reportsDirectory=coverage/ui-map --coverage.include='src/lib/ChatScreens/**/*.{ts,svelte}' --coverage.include='src/lib/Others/**/*.{ts,svelte}' --coverage.include='src/lib/SideBars/**/*.{ts,svelte}' --coverage.include='src/ts/server/**/*.{ts,svelte}' --coverage.reporter=text --coverage.reporter=json-summary --coverage.thresholds.lines=8 --coverage.thresholds.statements=7 --coverage.thresholds.functions=5 --coverage.thresholds.branches=4",
    "coverage:ui-map:html": "pnpm coverage:ui-map --coverage.reporter=html",
    "analyze:db": "tsx util/analyze-database.ts",
    "build:smoke": "cross-env VITE_FASTIFY_BROWSER_SMOKE=TRUE vite build",
    "smoke:fastify-browser": "pnpm build:smoke && cross-env VITE_FASTIFY_BROWSER_SMOKE=TRUE RISU_FAST_BOOTSTRAP_ARTIFACT_REQUIRED=true playwright test -c playwright.fastify-smoke.config.ts",
    "dev:agent": "cross-env RISU_API_TRACE_MODE=agent tsx util/agent-dev.ts",
    "dev:human": "cross-env RISU_API_TRACE_MODE=human RISU_AGENT_API_PORT=6001 RISU_AGENT_DEV_PORT=6002 tsx util/agent-dev.ts",
    "ts:agent": "tsx util/ts-agent.ts",
    "api:dev": "tsx watch server/fastify/src/index.ts",
    "api:dev:flag": "tsx util/api-flag-dev.ts",
    "api:start": "tsx server/fastify/src/index.ts",
    "diagnostics:credential": "tsx util/diagnostics-credential.ts",
    "diagnostics:remote": "tsx util/diagnostics-remote.ts"
  },
  "dependencies": {
    "@adobe/css-tools": "4.4.4",
    "@aws-crypto/sha256-js": "^5.2.0",
    "@breezystack/lamejs": "^1.2.7",
    "@dqbd/tiktoken": "^1.0.22",
    "@fastify/compress": "^8.3.1",
    "@fastify/multipart": "^10.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.3",
    "@fastify/websocket": "^11.2.0",
    "@huggingface/jinja": "^0.2.2",
    "@huggingface/transformers": "^3.8.1",
    "@lucide/svelte": "^0.562.0",
    "@mlc-ai/web-llm": "^0.2.80",
    "@mlc-ai/web-tokenizers": "^0.1.6",
    "@noble/ciphers": "^2.2.0",
    "@risuai/ccardlib": "^0.4.2",
    "@risuai/protocol": "workspace:*",
    "@risuai/shared-core": "workspace:*",
    "@smithy/protocol-http": "^3.3.0",
    "@smithy/signature-v4": "^2.3.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/markdown-it": "^14.1.2",
    "@types/trusted-types": "^2.0.7",
    "acorn": "^8.15.0",
    "acorn-walk": "^8.3.4",
    "astring": "^1.9.0",
    "buffer": "^6.0.3",
    "codemirror": "^6.0.2",
    "compression-streams-polyfill": "^0.1.7",
    "core-js": "^3.47.0",
    "crc": "^4.3.2",
    "diff": "^7.0.0",
    "dompurify": "^3.3.2",
    "fastify": "^5.8.5",
    "fflate": "^0.8.2",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "katex": "^0.16.27",
    "localforage": "^1.10.0",
    "lodash": "^4.17.21",
    "markdown-it": "^14.1.0",
    "mnemonist": "^0.40.3",
    "mobile-drag-drop": "3.0.0-rc.0",
    "monaco-editor": "^0.55.1",
    "msgpackr": "1.10.1",
    "ollama": "^0.5.18",
    "pdfjs-dist": "^4.10.38",
    "png-chunk-text": "^1.0.0",
    "postcss-selector-parser": "^7.1.1",
    "pyodide": "^0.27.7",
    "rfdc": "^1.4.1",
    "sortablejs": "^1.15.6",
    "streamsaver": "^2.0.6",
    "sucrase": "^3.35.1",
    "sv": "^0.11.0",
    "svelte-awesome-color-picker": "^4.1.0",
    "three": "^0.154.0",
    "tippy.js": "^6.3.7",
    "tsx": "^4.22.3",
    "uuid": "^9.0.1",
    "wasmoon": "^1.16.0",
    "wavefile": "^11.0.0",
    "web-push": "^3.6.7",
    "web-streams-polyfill": "^3.3.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@rollup/plugin-strip": "^3.0.4",
    "@sveltejs/vite-plugin-svelte": "^7.0.0",
    "@swc/core": "1.5.7",
    "@tailwindcss/typography": "^0.5.19",
    "@tsconfig/svelte": "^5.0.6",
    "@types/diff": "^6.0.0",
    "@types/libsodium-wrappers-sumo": "^0.7.8",
    "@types/lodash": "^4.17.21",
    "@types/lodash.isequal": "^4.5.8",
    "@types/node": "^22.19.3",
    "@types/showdown": "^2.0.6",
    "@types/sortablejs": "^1.15.9",
    "@types/streamsaver": "^2.0.5",
    "@types/three": "^0.154.0",
    "@types/uuid": "^9.0.8",
    "@types/web-push": "^3.6.4",
    "@types/wicg-file-system-access": "^2020.9.8",
    "@vitest/coverage-v8": "5.0.0-rc.3",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "autoprefixer": "^10.4.23",
    "cross-env": "^10.1.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.5.3",
    "happy-dom": "^20.1.0",
    "internal-ip": "^7.0.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "prettier-plugin-svelte": "^3.5.2",
    "source-map": "^0.7.6",
    "svelte": "^5.55.1",
    "svelte-check": "^4.3.5",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.3",
    "vite-plugin-wasm": "3.6.0",
    "vitest": "5.0.0-rc.3"
  }
}
